# Copy this file to .env for a real PostgreSQL-backed local environment.
# Docker publishes PostgreSQL on 5433 to avoid conflicting with native PostgreSQL.
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql://florea:florea@localhost:5433/florea_haven
DATABASE_SSL=false
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
APP_ENV=development
VITE_API_URL=

# Use a long, random value in every persistent or hosted environment.
JWT_SECRET=
SESSION_DAYS=7

# Optional separate PostgreSQL test database. Tests use a private random schema.
# TEST_DATABASE_URL=postgresql://florea:florea@localhost:5433/florea_haven
# Default rate limiting is per process; use shared storage before scaling workers.
RATELIMIT_STORAGE_URI=memory://

# Used only by `npm run admin:create`; never commit real values.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
