{
  "name": "florea-haven",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.3",
  "workspaces": [
    "client"
  ],
  "scripts": {
    "dev": "concurrently --kill-others --names client,api --prefix-colors magenta,green \"npm run dev --workspace client\" \"npm run dev:backend\"",
    "backend:setup": "node scripts/backend.mjs setup",
    "dev:backend": "node scripts/backend.mjs dev",
    "start": "node scripts/backend.mjs serve",
    "build": "npm run build --workspace client",
    "test": "npm run test:backend && npm run test --workspace client",
    "test:backend": "node scripts/backend.mjs test",
    "lint": "npm run lint:backend && npm run lint --workspace client",
    "lint:backend": "node scripts/backend.mjs lint",
    "format:backend": "node scripts/backend.mjs format",
    "format": "prettier --write \"**/*.{js,jsx,json,md,yml,yaml,css}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{js,jsx,json,md,yml,yaml,css}\" --ignore-path .prettierignore",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:setup": "npm run db:up && npm run db:migrate && npm run db:seed",
    "db:migrate": "node scripts/backend.mjs migrate",
    "db:seed": "node scripts/backend.mjs seed",
    "admin:create": "node scripts/backend.mjs create-admin"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.6.2"
  }
}
